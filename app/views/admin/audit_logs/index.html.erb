<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Audit Logs</h1>
    <span class="text-muted">Total: <%= @total_count %> entries</span>
  </div>

  <!-- Filters -->
  <div class="card mb-4">
    <div class="card-body">
      <%= form_with url: admin_audit_logs_path, method: :get, local: true, class: "row g-3" do %>
        <div class="col-md-3">
          <%= select_tag :action_filter,
              options_for_select([["All Actions", ""]] + AdminAuditLog::ACTIONS.map { |a| [a.titleize, a] }, params[:action_filter]),
              class: "form-select" %>
        </div>
        <div class="col-md-3">
          <%= select_tag :resource_type,
              options_for_select([["All Resources", ""], ["User", "User"], ["Document", "Document"], ["Category", "Category"], ["System", "System"]], params[:resource_type]),
              class: "form-select" %>
        </div>
        <div class="col-md-3">
          <%= select_tag :user_id,
              options_for_select([["All Admins", ""]] + User.admin.pluck(:email, :id), params[:user_id]),
              class: "form-select" %>
        </div>
        <div class="col-md-3">
          <%= submit_tag "Filter", class: "btn btn-primary" %>
          <%= link_to "Clear", admin_audit_logs_path, class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Logs Table -->
  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th>Time</th>
            <th>Admin</th>
            <th>Action</th>
            <th>Resource</th>
            <th>IP Address</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @audit_logs.each do |log| %>
            <tr>
              <td><%= log.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
              <td><%= log.user&.email || "Unknown" %></td>
              <td>
                <span class="badge bg-<%= action_badge_color(log.action) %>">
                  <%= log.action %>
                </span>
              </td>
              <td>
                <%= log.resource_type %>
                <% if log.resource_id %>
                  <small class="text-muted">#<%= log.resource_id %></small>
                <% end %>
              </td>
              <td><code><%= log.ip_address %></code></td>
              <td>
                <%= link_to "Details", admin_audit_log_path(log), class: "btn btn-sm btn-outline-secondary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pagination -->
  <% if @total_pages > 1 %>
    <nav class="mt-4">
      <ul class="pagination justify-content-center">
        <% if @current_page > 1 %>
          <li class="page-item">
            <%= link_to "Previous", admin_audit_logs_path(page: @current_page - 1, action_filter: params[:action_filter], resource_type: params[:resource_type], user_id: params[:user_id]), class: "page-link" %>
          </li>
        <% end %>
        <li class="page-item disabled">
          <span class="page-link">Page <%= @current_page %> of <%= @total_pages %></span>
        </li>
        <% if @current_page < @total_pages %>
          <li class="page-item">
            <%= link_to "Next", admin_audit_logs_path(page: @current_page + 1, action_filter: params[:action_filter], resource_type: params[:resource_type], user_id: params[:user_id]), class: "page-link" %>
          </li>
        <% end %>
      </ul>
    </nav>
  <% end %>
</div>
