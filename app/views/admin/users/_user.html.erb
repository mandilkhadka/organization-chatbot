<tr id="<%= dom_id(user) %>">
  <td>
    <div class="user-info">
      <div class="user-avatar">
        <i class="fas fa-user-circle"></i>
      </div>
      <div>
        <span class="user-email"><%= user.email %></span>
        <% if user == current_user %>
          <span class="badge badge-you ms-2">You</span>
        <% end %>
      </div>
    </div>
  </td>
  <td>
    <% if user.admin? %>
      <span class="badge badge-admin">
        <i class="fas fa-shield-alt me-1"></i>Admin
      </span>
    <% else %>
      <span class="badge badge-employee">
        <i class="fas fa-user me-1"></i>Employee
      </span>
    <% end %>
  </td>
  <td>
    <span class="document-meta"><%= user.try(:conversations_count) || user.conversations.count %> conversations</span>
  </td>
  <td>
    <span class="document-meta"><%= user.created_at.strftime("%b %d, %Y") %></span>
  </td>
  <td>
    <div class="table-actions">
      <%= link_to admin_user_path(user), class: "btn btn-icon btn-outline-secondary", title: "View", "aria-label": "View #{user.email}" do %>
        <i class="fas fa-eye" aria-hidden="true"></i>
      <% end %>
      <%= link_to edit_admin_user_path(user), class: "btn btn-icon btn-outline-primary", title: "Edit", "aria-label": "Edit #{user.email}" do %>
        <i class="fas fa-edit" aria-hidden="true"></i>
      <% end %>
      <% unless user == current_user %>
        <%= button_to admin_user_path(user), method: :delete, class: "btn btn-icon btn-outline-danger", title: "Delete", "aria-label": "Delete #{user.email}", data: { turbo_confirm: "Are you sure you want to delete this user? This action cannot be undone." } do %>
          <i class="fas fa-trash" aria-hidden="true"></i>
        <% end %>
      <% end %>
    </div>
  </td>
</tr>
