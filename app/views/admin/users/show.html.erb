<div class="container py-4">
  <div class="admin-header">
    <h1>
      <i class="fas fa-user"></i>
      User Details
    </h1>
    <div class="d-flex gap-2">
      <%= link_to edit_admin_user_path(@user), class: "btn btn-primary" do %>
        <i class="fas fa-edit me-2"></i>Edit
      <% end %>
      <%= link_to admin_users_path, class: "btn btn-secondary" do %>
        <i class="fas fa-arrow-left me-2"></i>Back
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-4">
      <div class="card user-profile-card mb-4">
        <div class="card-body text-center">
          <div class="user-avatar-large">
            <i class="fas fa-user-circle"></i>
          </div>
          <h4 class="mt-3 mb-1"><%= @user.email %></h4>
          <% if @user.admin? %>
            <span class="badge badge-admin">
              <i class="fas fa-shield-alt me-1"></i>Admin
            </span>
          <% else %>
            <span class="badge badge-employee">
              <i class="fas fa-user me-1"></i>Employee
            </span>
          <% end %>
        </div>
        <div class="card-footer">
          <div class="user-stats">
            <div class="stat">
              <span class="stat-value"><%= @user.conversations.count %></span>
              <span class="stat-label">Conversations</span>
            </div>
            <div class="stat">
              <span class="stat-value"><%= @user.documents.count %></span>
              <span class="stat-label">Documents</span>
            </div>
          </div>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header">
          <h6 class="mb-0">
            <i class="fas fa-info-circle me-2"></i>Account Info
          </h6>
        </div>
        <div class="card-body">
          <div class="info-row">
            <span class="info-label">Created</span>
            <span class="info-value"><%= @user.created_at.strftime("%B %d, %Y at %I:%M %p") %></span>
          </div>
          <div class="info-row">
            <span class="info-label">Last Updated</span>
            <span class="info-value"><%= @user.updated_at.strftime("%B %d, %Y at %I:%M %p") %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-8">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h6 class="mb-0">
            <i class="fas fa-comments me-2"></i>Recent Conversations
          </h6>
        </div>
        <div class="card-body p-0">
          <% if @conversations.empty? %>
            <div class="admin-empty-state py-4">
              <p class="mb-0">No conversations yet.</p>
            </div>
          <% else %>
            <div class="conversation-list">
              <% @conversations.each do |conversation| %>
                <div class="conversation-item">
                  <div class="conversation-info">
                    <span class="conversation-title">
                      <%= conversation.title.presence || "Untitled Conversation" %>
                    </span>
                    <span class="conversation-meta">
                      <%= conversation.messages.size %> messages · 
                      <%= time_ago_in_words(conversation.updated_at) %> ago
                    </span>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
