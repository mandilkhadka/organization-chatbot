<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="admin-header mb-4">
        <h1>
          <i class="fas fa-user-plus"></i>
          Add Employee
        </h1>
      </div>

      <div class="upload-form">
        <%= form_with model: [:admin, @user], local: true do |f| %>
          <% if @user.errors.any? %>
            <div class="alert alert-danger mb-4">
              <i class="fas fa-exclamation-circle me-2"></i>
              <div>
                <strong>Please fix the following errors:</strong>
                <ul class="mb-0 mt-2">
                  <% @user.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          <% end %>

          <div class="mb-4">
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, class: "form-control form-control-lg", placeholder: "employee@company.com", autofocus: true %>
          </div>

          <div class="mb-4">
            <%= f.label :password, class: "form-label" %>
            <%= f.password_field :password, class: "form-control form-control-lg", placeholder: "Create a password" %>
            <div class="form-text mt-2">
              <i class="fas fa-info-circle me-1"></i>
              Minimum 12 characters
            </div>
          </div>

          <div class="mb-4">
            <%= f.label :password_confirmation, "Confirm Password", class: "form-label" %>
            <%= f.password_field :password_confirmation, class: "form-control form-control-lg", placeholder: "Confirm password" %>
          </div>

          <div class="mb-4">
            <%= f.label :role, class: "form-label" %>
            <%= f.select :role, User.roles.keys.map { |r| [r.titleize, r] }, {}, class: "form-select form-select-lg" %>
            <div class="form-text mt-2">
              <i class="fas fa-info-circle me-1"></i>
              Admins can manage documents and users. Employees can only chat.
            </div>
          </div>

          <div class="d-flex gap-3 pt-2">
            <%= link_to admin_users_path, class: "btn btn-secondary" do %>
              <i class="fas fa-arrow-left me-2"></i>Cancel
            <% end %>
            <%= f.submit "Create Employee", class: "btn btn-primary flex-grow-1" %>
          </div>
        <% end %>
      </div>

      <div class="credential-info mt-4">
        <div class="card bg-info-subtle">
          <div class="card-body">
            <h6 class="card-title text-info">
              <i class="fas fa-info-circle me-2"></i>Employee Onboarding
            </h6>
            <p class="card-text text-info-emphasis small mb-0">
              After creating the account, share the email and password with the employee. They can use these credentials to log in and start chatting with the knowledge assistant.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
