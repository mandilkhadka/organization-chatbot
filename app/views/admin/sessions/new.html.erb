<div class="admin-login-header">
  <span class="admin-badge">Administrator</span>
  <h1>Admin Portal</h1>
  <p>Sign in to manage your organization</p>
</div>

<%= form_with url: admin_login_path, method: :post, local: true, class: "admin-login-form" do |f| %>
  <div class="form-group mb-3">
    <%= label_tag :email, "Email Address", class: "form-label" %>
    <%= email_field_tag :email, params[:email], class: "form-control", placeholder: "admin@example.com", autofocus: true, required: true %>
  </div>

  <div class="form-group mb-4">
    <%= label_tag :password, "Password", class: "form-label" %>
    <%= password_field_tag :password, nil, class: "form-control", placeholder: "Enter your password", required: true %>
  </div>

  <div class="d-grid">
    <%= submit_tag "Sign In to Admin", class: "btn btn-primary btn-lg w-100" %>
  </div>
<% end %>

<div class="text-center mt-4">
  <%= link_to "← Back to main site", root_path, class: "text-muted" %>
  <br>
  <%= link_to "Employee? Sign in here", new_user_session_path, class: "text-muted small" %>
</div>
