<div class="hero-section auth-section">
  <div class="hero-content auth-content">
    <div class="brand-icon-large brand-icon-sm animate-fade-in-up">
      <i class="fas fa-shield-halved"></i>
    </div>

    <span class="auth-pill animate-fade-in-up">Administrator</span>
    <h1 class="hero-title auth-title">Admin Portal</h1>
    <p class="hero-description auth-description">Sign in to manage your organization</p>

    <div class="card auth-card animate-fade-in-up animate-delay-2">
      <div class="card-body p-4">
        <%= form_with url: admin_login_path, method: :post, local: true do |f| %>
          <div class="mb-3">
            <%= label_tag :email, "Email", class: "form-label" %>
            <%= email_field_tag :email, params[:email],
                                class: "form-control form-control-lg",
                                autocomplete: "email",
                                autofocus: true,
                                required: true %>
          </div>

          <div class="mb-4">
            <%= label_tag :password, "Password", class: "form-label" %>
            <%= password_field_tag :password, nil,
                                   class: "form-control form-control-lg",
                                   autocomplete: "current-password",
                                   required: true %>
          </div>

          <div class="d-grid gap-2">
            <%= submit_tag "Sign in", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>

        <div class="text-center mt-4 pt-3 border-top auth-footer">
          <p class="mb-2 auth-text">
            <%= link_to root_path, class: "auth-link" do %>
              <i class="fas fa-arrow-left me-1"></i>Back to main site
            <% end %>
          </p>
          <p class="mb-0 auth-text">
            <%= link_to "Employee sign in", new_user_session_path, class: "auth-link" %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
