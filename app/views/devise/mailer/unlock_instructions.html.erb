<% content_for :title, "Unlock your account" %>

<h1 style="margin:0 0 16px; font-size:22px; font-weight:600; color:#0f172a; letter-spacing:-0.01em;">
  Unlock your account
</h1>

<p style="margin:0 0 16px; color:#334155; font-size:15px;">
  Hi <%= @resource.email %>,
</p>

<p style="margin:0 0 16px; color:#334155; font-size:15px;">
  Your account was locked after too many unsuccessful sign-in attempts. If that was you, click the button below to unlock it and try again.
</p>

<%= render "devise/mailer/button",
           url: unlock_url(@resource, unlock_token: @token),
           label: "Unlock account" %>

<p style="margin:0 0 8px; color:#64748b; font-size:13px;">
  Or copy and paste this link into your browser:
</p>
<p style="margin:0 0 16px; color:#0d9488; font-size:13px; word-break:break-all;">
  <%= unlock_url(@resource, unlock_token: @token) %>
</p>

<p style="margin:24px 0 0; color:#64748b; font-size:13px;">
  If you don't recognize these attempts, change your password as soon as you regain access.
</p>
