<% content_for :title, "Password changed" %>

<h1 style="margin:0 0 16px; font-size:22px; font-weight:600; color:#0f172a; letter-spacing:-0.01em;">
  Your password was changed
</h1>

<p style="margin:0 0 16px; color:#334155; font-size:15px;">
  Hi <%= @resource.email %>,
</p>

<p style="margin:0 0 16px; color:#334155; font-size:15px;">
  Your Knowledge Assistant password was changed just now. You can sign in with your new password right away.
</p>

<p style="margin:24px 0 0; color:#b91c1c; font-size:13px; font-weight:600;">
  Wasn't you? Reset your password immediately and let your administrator know.
</p>
