<% content_for :title, "Reset your password" %>

<h1 style="margin:0 0 16px; font-size:22px; font-weight:600; color:#0f172a; letter-spacing:-0.01em;">
  Reset your password
</h1>

<p style="margin:0 0 16px; color:#334155; font-size:15px;">
  Hi <%= @resource.email %>,
</p>

<p style="margin:0 0 16px; color:#334155; font-size:15px;">
  We received a request to reset your Knowledge Assistant password. Click the button below to choose a new one. This link expires in
  <%= ((Devise.reset_password_within || 6.hours) / 1.hour).to_i %> hours.
</p>

<%= render "devise/mailer/button",
           url: edit_password_url(@resource, reset_password_token: @token),
           label: "Reset password" %>

<p style="margin:0 0 8px; color:#64748b; font-size:13px;">
  Or copy and paste this link into your browser:
</p>
<p style="margin:0 0 16px; color:#0d9488; font-size:13px; word-break:break-all;">
  <%= edit_password_url(@resource, reset_password_token: @token) %>
</p>

<p style="margin:24px 0 0; color:#64748b; font-size:13px;">
  If you didn't request a password reset, you can safely ignore this email — your password won't change.
</p>
