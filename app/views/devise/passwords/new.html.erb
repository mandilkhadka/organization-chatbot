<div class="hero-section auth-section">
  <div class="hero-content auth-content">
    <div class="brand-icon-large brand-icon-sm animate-fade-in-up">
      <i class="fas fa-key"></i>
    </div>

    <h1 class="hero-title auth-title">Reset Password</h1>
    <p class="hero-description auth-description">Enter your email and we'll send you reset instructions</p>

    <div class="card auth-card animate-fade-in-up animate-delay-2">
      <div class="card-body p-4">
        <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
          <%= f.error_notification %>

          <div class="mb-4">
            <%= f.input :email,
                        required: true,
                        autofocus: true,
                        label: "Email",
                        input_html: { autocomplete: "email", class: "form-control form-control-lg" },
                        wrapper_html: { class: "mb-3" } %>
          </div>

          <div class="d-grid gap-2">
            <%= f.button :submit, "Send Reset Instructions", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>

        <div class="text-center mt-4 pt-3 border-top auth-footer">
          <p class="mb-0 auth-text">
            Remember your password?
            <%= link_to "Sign in", new_session_path(resource_name), class: "auth-link" %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
