<div class="hero-section" style="min-height: calc(100vh - 60px);">
  <div class="hero-content" style="max-width: 420px; width: 100%;">
    <div class="brand-icon-large animate-fade-in-up" style="width: 60px; height: 60px; font-size: 1.75rem; margin-bottom: 1.5rem;">
      <i class="fas fa-key"></i>
    </div>

    <h1 class="hero-title" style="font-size: 2rem; margin-bottom: 0.5rem;">Reset Password</h1>
    <p class="hero-description" style="margin-bottom: 2rem; opacity: 1;">Enter your email and we'll send you reset instructions</p>

    <div class="card animate-fade-in-up animate-delay-2" style="text-align: left;">
      <div class="card-body p-4">
        <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
          <%= f.error_notification %>

          <div class="mb-4">
            <%= f.input :email,
                        required: true,
                        autofocus: true,
                        label: "Email",
                        input_html: { autocomplete: "email", class: "form-control form-control-lg" },
                        wrapper_html: { class: "mb-3" } %>
          </div>

          <div class="d-grid gap-2">
            <%= f.button :submit, "Send Reset Instructions", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>

        <div class="text-center mt-4 pt-3 border-top" style="border-color: rgba(148, 163, 184, 0.2) !important;">
          <p class="mb-0" style="color: #94a3b8; font-size: 0.875rem;">
            Remember your password?
            <%= link_to "Sign in", new_session_path(resource_name), style: "color: #2dd4bf;" %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
