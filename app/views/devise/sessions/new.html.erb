<div class="hero-section auth-section">
  <div class="hero-content auth-content">
    <div class="brand-icon-large brand-icon-sm animate-fade-in-up">
      <i class="fas fa-user"></i>
    </div>

    <h1 class="hero-title auth-title">Welcome back</h1>
    <p class="hero-description auth-description">Sign in to continue to Knowledge Assistant</p>

    <div class="card auth-card animate-fade-in-up animate-delay-2">
      <div class="card-body p-4">
        <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="mb-3">
            <%= f.input :email,
                        required: false,
                        autofocus: true,
                        label: "Email",
                        input_html: { autocomplete: "email", class: "form-control form-control-lg" },
                        wrapper_html: { class: "mb-3" } %>
          </div>

          <div class="mb-3">
            <%= f.input :password,
                        required: false,
                        label: "Password",
                        input_html: { autocomplete: "current-password", class: "form-control form-control-lg" },
                        wrapper_html: { class: "mb-3" } %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="mb-4">
              <%= f.input :remember_me, as: :boolean, wrapper_html: { class: "form-check" } %>
            </div>
          <% end %>

          <div class="d-grid gap-2">
            <%= f.button :submit, "Sign In", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>

        <div class="text-center mt-4 pt-3 border-top auth-footer">
          <p class="mb-2 auth-text">
            <i class="fas fa-info-circle me-1"></i>
            Contact your administrator for account access.
          </p>
          <% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
            <p class="mb-2 auth-text">
              <%= link_to "Forgot your password?", new_password_path(resource_name), class: "auth-link" %>
            </p>
          <% end %>
          <p class="mb-0 auth-text">
            <%= link_to "Admin? Sign in here", admin_login_path, class: "auth-link" %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
