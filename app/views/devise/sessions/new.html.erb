<div class="hero-section" style="min-height: calc(100vh - 60px);">
  <div class="hero-content" style="max-width: 420px; width: 100%;">
    <div class="brand-icon-large animate-fade-in-up" style="width: 60px; height: 60px; font-size: 1.75rem; margin-bottom: 1.5rem;">
      <i class="fas fa-user"></i>
    </div>

    <h1 class="hero-title" style="font-size: 2rem; margin-bottom: 0.5rem;">Welcome back</h1>
    <p class="hero-description" style="margin-bottom: 2rem; opacity: 1;">Sign in to continue to Knowledge Assistant</p>

    <div class="card animate-fade-in-up animate-delay-2" style="text-align: left;">
      <div class="card-body p-4">
        <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="mb-3">
            <%= f.input :email,
                        required: false,
                        autofocus: true,
                        label: "Email",
                        input_html: { autocomplete: "email", class: "form-control form-control-lg" },
                        wrapper_html: { class: "mb-3" } %>
          </div>

          <div class="mb-3">
            <%= f.input :password,
                        required: false,
                        label: "Password",
                        input_html: { autocomplete: "current-password", class: "form-control form-control-lg" },
                        wrapper_html: { class: "mb-3" } %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="mb-4">
              <%= f.input :remember_me, as: :boolean, wrapper_html: { class: "form-check" } %>
            </div>
          <% end %>

          <div class="d-grid gap-2">
            <%= f.button :submit, "Sign In", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>

        <div class="text-center mt-4 pt-3 border-top" style="border-color: rgba(148, 163, 184, 0.2) !important;">
          <p class="mb-2" style="color: #94a3b8; font-size: 0.875rem;">
            <i class="fas fa-info-circle me-1"></i>
            Contact your administrator for account access.
          </p>
          <% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
            <p class="mb-0" style="color: #94a3b8; font-size: 0.875rem;">
              <%= link_to "Forgot your password?", new_password_path(resource_name), style: "color: #64748b;" %>
            </p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
