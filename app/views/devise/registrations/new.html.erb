<div class="hero-section auth-section">
  <div class="hero-content auth-content">
    <div class="brand-icon-large brand-icon-sm animate-fade-in-up">
      <i class="fas fa-user-plus"></i>
    </div>

    <h1 class="hero-title auth-title"><%= @initial_setup ? "Initial Setup" : "Create Account" %></h1>
    <p class="hero-description auth-description"><%= @initial_setup ? "Create the first admin account to get started" : "Join to access your organization's knowledge base" %></p>

    <% if @initial_setup %>
      <div class="alert alert-info animate-fade-in-up animate-delay-1 mb-3" style="max-width: 480px; margin: 0 auto;">
        <i class="fas fa-shield-alt me-2"></i>
        This account will have <strong>admin privileges</strong>. You can create employee accounts from the admin panel after setup.
      </div>
    <% end %>

    <div class="card auth-card animate-fade-in-up animate-delay-2">
      <div class="card-body p-4">
        <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
          <%= f.error_notification %>

          <div class="mb-3">
            <%= f.input :email,
                        required: true,
                        autofocus: true,
                        label: "Email",
                        input_html: { autocomplete: "email", class: "form-control form-control-lg" },
                        wrapper_html: { class: "mb-3" } %>
          </div>

          <div class="mb-3">
            <%= f.input :password,
                        required: true,
                        label: "Password",
                        hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
                        input_html: { autocomplete: "new-password", class: "form-control form-control-lg" },
                        wrapper_html: { class: "mb-3" } %>
          </div>

          <div class="mb-4">
            <%= f.input :password_confirmation,
                        required: true,
                        label: "Confirm Password",
                        input_html: { autocomplete: "new-password", class: "form-control form-control-lg" },
                        wrapper_html: { class: "mb-3" } %>
          </div>

          <div class="d-grid gap-2">
            <%= f.button :submit, "Create Account", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>

        <div class="text-center mt-4 pt-3 border-top auth-footer">
          <p class="mb-0 auth-text">
            Already have an account?
            <%= link_to "Sign in", new_session_path(resource_name), class: "auth-link" %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
