<nav class="navbar navbar-expand-lg navbar-main">
  <div class="container-fluid px-4">
    <%= link_to root_path, class: "navbar-brand" do %>
      <div class="brand-icon">
        <i class="fas fa-robot"></i>
      </div>
      <span>Knowledge Assistant</span>
    <% end %>

    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <% if user_signed_in? %>
          <li class="nav-item">
            <%= link_to conversations_path, class: "nav-link #{controller_name == 'conversations' ? 'active' : ''}" do %>
              <i class="fas fa-comments"></i>
              <span>Chat</span>
            <% end %>
          </li>
          <% if current_user.admin? %>
            <li class="nav-item dropdown">
              <a href="#" class="nav-link dropdown-toggle <%= controller_path.start_with?('admin') ? 'active' : '' %>" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-cog"></i>
                <span>Admin</span>
              </a>
              <ul class="dropdown-menu">
                <li>
                  <%= link_to admin_root_path, class: "dropdown-item" do %>
                    <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                  <% end %>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <%= link_to admin_users_path, class: "dropdown-item" do %>
                    <i class="fas fa-users me-2"></i>Manage Employees
                  <% end %>
                </li>
                <li>
                  <%= link_to admin_documents_path, class: "dropdown-item" do %>
                    <i class="fas fa-folder-open me-2"></i>Manage Documents
                  <% end %>
                </li>
                <li>
                  <%= link_to admin_categories_path, class: "dropdown-item" do %>
                    <i class="fas fa-tags me-2"></i>Categories
                  <% end %>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <%= link_to admin_audit_logs_path, class: "dropdown-item" do %>
                    <i class="fas fa-history me-2"></i>Audit Logs
                  <% end %>
                </li>
              </ul>
            </li>
          <% end %>
        <% end %>
      </ul>

      <ul class="navbar-nav">
        <% if user_signed_in? %>
          <li class="nav-item dropdown">
            <a href="#" class="nav-link dropdown-toggle user-menu" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              <i class="fas fa-user-circle"></i>
              <span class="user-email d-none d-md-inline"><%= current_user.email.split('@').first %></span>
              <% if current_user.admin? %>
                <span class="badge badge-admin">Admin</span>
              <% end %>
            </a>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
              <div class="dropdown-item-text text-muted small px-3 py-2">
                <%= current_user.email %>
              </div>
              <hr class="dropdown-divider my-1">
              <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item" do %>
                <i class="fas fa-sign-out-alt me-2"></i>Sign out
              <% end %>
            </div>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to new_user_session_path, class: "nav-link" do %>
              <i class="fas fa-sign-in-alt"></i>
              <span>Sign in</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
