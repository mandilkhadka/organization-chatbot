<div class="flash-container">
  <% if notice %>
    <div class="flash-notification flash-notice" role="alert">
      <i class="fas fa-check-circle flash-icon"></i>
      <span class="flash-message"><%= notice %></span>
      <button type="button" class="flash-close" data-bs-dismiss="alert" aria-label="Close">
        <i class="fas fa-times"></i>
      </button>
    </div>
  <% end %>
  <% if alert %>
    <div class="flash-notification flash-alert" role="alert">
      <i class="fas fa-exclamation-circle flash-icon"></i>
      <span class="flash-message"><%= alert %></span>
      <button type="button" class="flash-close" data-bs-dismiss="alert" aria-label="Close">
        <i class="fas fa-times"></i>
      </button>
    </div>
  <% end %>
</div>
