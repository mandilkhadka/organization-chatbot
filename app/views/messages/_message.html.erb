<% streaming_content ||= nil %>
<% is_streaming ||= false %>
<% show_typing = message.assistant? && message.streaming? && streaming_content.blank? %>

<div id="message_<%= message.id %>" class="message <%= message.user? ? 'message-user' : 'message-assistant' %> <%= 'streaming' if is_streaming %> animate-fade-in-up">
  <div class="message-avatar">
    <i class="fas <%= message.user? ? 'fa-user' : 'fa-robot' %>"></i>
  </div>

  <div class="message-bubble">
    <div class="message-content">
      <% if show_typing %>
        <div class="typing-indicator">
          <span></span>
          <span></span>
          <span></span>
        </div>
      <% elsif streaming_content.present? || message.content.present? %>
        <%= sanitize(simple_format(streaming_content || message.content), tags: %w[p br], attributes: []) %>
        <% if is_streaming %>
          <span class="cursor-blink">▌</span>
        <% end %>
      <% end %>
    </div>

    <% if message.assistant? && !is_streaming && message.message_sources.any? %>
      <div class="message-sources animate-fade-in">
        <div class="sources-label">
          <i class="fas fa-file-alt"></i>
          <span>Sources</span>
        </div>
        <div class="sources-list">
          <% message.message_sources.includes(document_chunk: :document).each do |source| %>
            <span class="badge-source">
              <i class="fas fa-file"></i>
              <%= source.document_chunk.document.title %>
            </span>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if message.assistant? && message.status_complete? && message.content.present? %>
      <div class="message-feedback animate-fade-in" data-controller="feedback" data-feedback-conversation-id-value="<%= message.conversation_id %>">
        <button
          class="feedback-btn <%= 'active' if message.feedback_positive? %>"
          data-message-id="<%= message.id %>"
          data-feedback="positive"
          data-action="click->feedback#submit"
          title="Helpful"
        >
          <i class="fas fa-thumbs-up"></i>
        </button>
        <button
          class="feedback-btn <%= 'active' if message.feedback_negative? %>"
          data-message-id="<%= message.id %>"
          data-feedback="negative"
          data-action="click->feedback#submit"
          title="Not helpful"
        >
          <i class="fas fa-thumbs-down"></i>
        </button>
      </div>
    <% end %>

    <% if message.status_failed? %>
      <div class="message-error">
        <i class="fas fa-exclamation-triangle"></i>
        <span>Failed to generate response</span>
      </div>
    <% end %>
  </div>
</div>
