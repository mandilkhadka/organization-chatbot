<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<%#
  Branded transactional email layout. Styles are inline because Outlook
  and several webmail clients strip <style> blocks. Keep changes minimal
  and test against a couple of clients (Litmus/Email-on-Acid) before shipping.
%>
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= content_for(:title).presence || "Knowledge Assistant" %></title>
  </head>
  <body style="margin:0; padding:0; background:#f6f7f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color:#0f172a; line-height:1.55;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" width="100%" style="background:#f6f7f9; padding: 32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="max-width:600px; width:100%; background:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 4px 16px rgba(15,23,42,0.06); border:1px solid #e5e7eb;">
            <tr>
              <td style="background:#0f172a; padding:24px 32px;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td style="vertical-align:middle;">
                      <span style="display:inline-block; width:36px; height:36px; line-height:36px; background:rgba(20,184,166,0.15); border:1px solid rgba(20,184,166,0.35); border-radius:8px; color:#5eead4; text-align:center; font-size:18px; font-weight:600;">K</span>
                    </td>
                    <td style="padding-left:12px; vertical-align:middle;">
                      <span style="color:#f1f5f9; font-size:16px; font-weight:600; letter-spacing:-0.01em;">Knowledge Assistant</span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:32px;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td style="background:#f9fafb; padding:20px 32px; border-top:1px solid #e5e7eb;">
                <p style="margin:0 0 4px; color:#64748b; font-size:12px;">
                  This is an automated message from Knowledge Assistant.
                </p>
                <p style="margin:0; color:#94a3b8; font-size:12px;">
                  If you didn't expect this, you can safely ignore it.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
