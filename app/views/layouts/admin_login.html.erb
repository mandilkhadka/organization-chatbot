<!DOCTYPE html>
<html>
  <head>
    <title>Admin Login - Organization Chatbot</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
