# Organization Chatbot — environment variables
# Copy to .env and fill in. Never commit .env.

# =============================================================================
# Required
# =============================================================================

# Gemini API — used for embeddings (ingestion) and chat completion.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# PostgreSQL connection string. In dev, the host can be a local Postgres or
# any compatible managed service (Supabase, Neon, RDS). Must have pgvector.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/organization_chatbot_development

# Rails master key — encrypts config/credentials.yml.enc. Generate with `rails secret`.
RAILS_MASTER_KEY=

# Devise pepper — application-level secret mixed into password hashing.
# Generate with `rails secret`. NEVER change this in prod (invalidates all passwords).
DEVISE_PEPPER=

# =============================================================================
# Production-required
# =============================================================================

# Canonical hostname. Used for ActionMailer URLs, CSP allowlists, and DNS
# rebinding protection (`config.hosts`).
# APP_HOST=chatbot.example.com
# ADDITIONAL_HOSTS=www.chatbot.example.com,chatbot.staging.example.com

# Redis — backs Sidekiq, Rails.cache, and Rack::Attack throttle counters.
# A null cache_store would silently disable rate limiting in prod.
# REDIS_URL=redis://localhost:6379/0

# SMTP — required for password resets and account notifications.
# SMTP_ADDRESS=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain
# SMTP_DOMAIN=chatbot.example.com
# MAILER_SENDER=no-reply@chatbot.example.com

# =============================================================================
# Observability (optional but recommended in prod)
# =============================================================================

# Sentry DSN. When unset, Sentry stays silent.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_PROFILES_SAMPLE_RATE=0.05
# GIT_SHA=                       # set by CI for release tagging

# =============================================================================
# Tuning knobs (all have safe defaults — uncomment only to override)
# =============================================================================

# Authentication / sessions
# ALLOW_PUBLIC_REGISTRATION=false
# ADMIN_SESSION_TIMEOUT_MINUTES=30

# Upload limits
# MAX_UPLOAD_SIZE_MB=10
# MAX_BULK_FILES=20
# MAX_EXTRACTED_TEXT_MB=5

# RAG pipeline
# EMBEDDING_MODEL=gemini-embedding-001
# CHAT_MODEL=gemini-2.0-flash
# RUBY_FALLBACK_MAX_CHUNKS=5000

# Sidekiq
# SIDEKIQ_CONCURRENCY=10
# SIDEKIQ_REDIS_POOL_SIZE=12

# Health checks — set true to include Gemini auth probe in /health/deep.
# HEALTH_CHECK_GEMINI=false

# ActionCable WebSocket host (used by CSP connect-src and config/cable.yml).
# CABLE_HOST=localhost

# Rails environment (default depends on how you boot).
# RAILS_ENV=development
# RAILS_LOG_LEVEL=info
