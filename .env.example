# Organization Chatbot - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# GEMINI API (Required)
# ===========================================
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# SUPABASE (Required)
# ===========================================
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
# Go to Settings > API to find these values

# Your Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous/public key (safe for client-side)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role key (server-side only, keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# PostgreSQL connection string for Supabase
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Get this from: Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# ===========================================
# RAILS (Required)
# ===========================================
# Generate with: rails secret
RAILS_MASTER_KEY=your_rails_master_key_here

# ===========================================
# SECURITY (Required for Production)
# ===========================================
# Devise pepper for password hashing - adds application-level secret
# Generate with: rails secret
# WARNING: Changing this will invalidate all existing passwords!
DEVISE_PEPPER=your_devise_pepper_here

# Rails environment (development, test, production)
RAILS_ENV=development

# Application host (for production emails and URLs)
# APP_HOST=yourdomain.com

# Email sender address for Devise emails
# MAILER_SENDER=noreply@yourdomain.com

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================

# Redis URL for Sidekiq (if using background jobs)
# REDIS_URL=redis://localhost:6379/1

# Ollama host (if using local LLM as fallback)
# OLLAMA_HOST=http://localhost:11434

# Maximum file upload size in MB (default: 10)
# MAX_UPLOAD_SIZE_MB=10

# Embedding model (default in code: gemini-embedding-exp-03-07 — EXPERIMENTAL)
# Recommended GA: gemini-embedding-001
# EMBEDDING_MODEL=gemini-embedding-001

# Chat model (default: gemini-2.0-flash)
# CHAT_MODEL=gemini-2.0-flash

# Upload caps (defaults shown)
# MAX_UPLOAD_SIZE_MB=10
# MAX_BULK_FILES=20
# MAX_EXTRACTED_TEXT_MB=5
# RUBY_FALLBACK_MAX_CHUNKS=5000

# ActionCable WebSocket host (used by CSP connect-src and cable.yml)
# CABLE_HOST=localhost
